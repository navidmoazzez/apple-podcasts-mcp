{
  "name": "@thenavidm/apple-podcasts-mcp",
  "version": "1.0.0",
  "description": "Apple Podcasts MCP server for Claude Code and AI agents. 32 tools for podcast search, chart rank tracking, listener reviews, RSS feed parsing, your own subscription library with on-device transcript search, and Apple Podcasts Connect analytics.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "apple-podcasts-mcp": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "author": "Navid Moazzez <https://navid.me>",
  "homepage": "https://navid.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenavidm/apple-podcasts-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/thenavidm/apple-podcasts-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "apple-podcasts",
    "podcast",
    "podcasts",
    "podcast-analytics",
    "podcast-charts",
    "itunes",
    "rss",
    "transcripts",
    "mcp-server",
    "claude",
    "claude-code",
    "ai-agents",
    "llm-tools"
  ],
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ]
}
